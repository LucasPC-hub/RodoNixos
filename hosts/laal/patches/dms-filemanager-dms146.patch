diff -ruN a/appimage_icon.py b/appimage_icon.py
--- a/appimage_icon.py
+++ b/appimage_icon.py
@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+"""Statically extract an AppImage icon into the icon cache.
+
+Usage: appimage_icon.py <appimage> <cache_dir> <stem>
+
+The AppImage is never executed. Its ELF runtime header is parsed to locate
+the embedded SquashFS image, which is read with unsquashfs (-lls / -cat)
+straight into this process; nothing from the image is unpacked to disk.
+
+Exit status / output:
+  0  icon cached; its absolute path is printed on stdout
+  2  no safely readable icon (not a type-2 SquashFS AppImage, or no icon)
+  1  error; reason on stderr
+"""
+import os
+import re
+import resource
+import selectors
+import stat
+import struct
+import subprocess
+import sys
+import tempfile
+import time
+
+# The parent package may substitute an absolute store path here.
+UNSQUASHFS = "unsquashfs"
+
+MAX_ICON_BYTES = 4 * 1024 * 1024
+MAX_LISTING_BYTES = 8 * 1024 * 1024
+CALL_TIMEOUT = 20.0
+SAFE_STEM = re.compile(r"[^/\x00-\x1f\x7f.][^/\x00-\x1f\x7f]{0,127}")
+# "-rw-r--r-- user/group   1234 2024-01-01 00:00 squashfs-root/name"
+LISTING_LINE = re.compile(
+    r"([-dlbcps])\S{9} \S+ +(\d+) \d{4}-\d\d-\d\d \d\d:\d\d squashfs-root/(.+)")
+
+
+class NoIcon(Exception):
+    pass
+
+
+def squashfs_offset(fd, size):
+    """Offset of the SquashFS image appended to the ELF runtime."""
+    hdr = os.pread(fd, 64, 0)
+    if len(hdr) < 64 or hdr[:4] != b"\x7fELF":
+        raise NoIcon("not an ELF (type-2) AppImage")
+    endian = {1: "<", 2: ">"}.get(hdr[5])
+    if endian is None:
+        raise NoIcon("unknown ELF byte order")
+    if hdr[4] == 2:
+        (shoff,) = struct.unpack_from(endian + "Q", hdr, 0x28)
+        shentsize, shnum = struct.unpack_from(endian + "HH", hdr, 0x3A)
+    elif hdr[4] == 1:
+        (shoff,) = struct.unpack_from(endian + "I", hdr, 0x20)
+        shentsize, shnum = struct.unpack_from(endian + "HH", hdr, 0x2E)
+    else:
+        raise NoIcon("unknown ELF class")
+    offset = shoff + shentsize * shnum
+    if not 0 < offset < size or os.pread(fd, 4, offset) != b"hsqs":
+        raise NoIcon("no SquashFS image after the ELF runtime")
+    return offset
+
+
+def _deny_file_writes():
+    # unsquashfs is only asked to list or cat to a pipe; refuse any file writes.
+    resource.setrlimit(resource.RLIMIT_FSIZE, (0, 0))
+
+
+def run_capped(args, fd, limit):
+    """Run unsquashfs, returning stdout bytes, or None on failure/overflow/timeout."""
+    try:
+        proc = subprocess.Popen(
+            [UNSQUASHFS] + args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL, pass_fds=(fd,), cwd="/", close_fds=True,
+            preexec_fn=_deny_file_writes)
+    except FileNotFoundError:
+        raise RuntimeError("unsquashfs (squashfs-tools >= 4.6) not found")
+    chunks, total, ok = [], 0, True
+    deadline = time.monotonic() + CALL_TIMEOUT
+    with selectors.DefaultSelector() as sel:
+        sel.register(proc.stdout, selectors.EVENT_READ)
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0 or not sel.select(remaining):
+                ok = False
+                break
+            data = os.read(proc.stdout.fileno(), 65536)
+            if not data:
+                break
+            total += len(data)
+            if total > limit:
+                ok = False
+                break
+            chunks.append(data)
+    if not ok:
+        proc.kill()
+    proc.stdout.close()
+    if proc.wait() != 0 or not ok:
+        return None
+    return b"".join(chunks)
+
+
+def image_ext(data):
+    if data.startswith(b"\x89PNG\r\n\x1a\n"):
+        return "png"
+    if data.startswith(b"\xff\xd8\xff"):
+        return "jpg"
+    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
+        return "webp"
+    if b"<svg" in data[:4096].lower():
+        return "svg"
+    return None
+
+
+def list_entries(fd, base, extra):
+    out = run_capped(["-o", str(base), "-lls", "-UTC"] + extra, fd, MAX_LISTING_BYTES)
+    entries = []
+    for raw in (out or b"").decode("utf-8", "surrogateescape").split("\n"):
+        m = LISTING_LINE.fullmatch(raw)
+        if not m:
+            continue
+        kind, size, name = m.group(1), int(m.group(2)), m.group(3)
+        if kind == "l":
+            name = name.split(" -> ", 1)[0]
+            size = 0  # link length, not icon size: rank after regular files
+        elif kind != "-":
+            continue
+        entries.append((name, kind, size))
+    return entries
+
+
+def ranked(entries, exts, limit=3):
+    picks = [e for e in entries if e[0].lower().rsplit(".", 1)[-1] in exts]
+    picks.sort(key=lambda e: (e[1] != "-", -e[2]))
+    return [e[0] for e in picks[:limit]]
+
+
+def candidates(fd, base):
+    """Same priority as the old staged extraction: root png, root svg,
+    .DirIcon, then usr/share/{icons,pixmaps}."""
+    root = list_entries(fd, base, ["-max-depth", "1", "/dev/fd/%d" % fd])
+    yield from ranked(root, {"png"})
+    yield from ranked(root, {"svg"})
+    yield ".DirIcon"
+    themed = []
+    for subtree in ("usr/share/icons", "usr/share/pixmaps"):
+        themed += list_entries(fd, base, ["/dev/fd/%d" % fd, subtree])
+    yield from ranked(themed, {"png", "svg", "jpg", "jpeg", "webp"})
+
+
+def read_icon(fd, base, name):
+    # -cat resolves symlinks inside the image only; it never reads host paths.
+    return run_capped(["-o", str(base), "-no-wildcards", "-cat", "/dev/fd/%d" % fd, name],
+                      fd, MAX_ICON_BYTES)
+
+
+def store(cache_dir, stem, ext, data):
+    os.makedirs(cache_dir, mode=0o700, exist_ok=True)
+    dest = os.path.join(cache_dir, stem + "." + ext)
+    tfd, tmp = tempfile.mkstemp(dir=cache_dir, prefix=".icon-")
+    try:
+        with os.fdopen(tfd, "wb") as f:
+            f.write(data)
+        os.chmod(tmp, 0o644)
+        os.replace(tmp, dest)
+    except BaseException:
+        os.unlink(tmp)
+        raise
+    return dest
+
+
+def main(argv):
+    if len(argv) != 3:
+        print("usage: appimage_icon.py <appimage> <cache_dir> <stem>", file=sys.stderr)
+        return 1
+    app_path, cache_dir, stem = argv
+    if not SAFE_STEM.fullmatch(stem) or not os.path.isabs(cache_dir):
+        print("unsafe icon cache name: %r" % stem, file=sys.stderr)
+        return 1
+    try:
+        # O_NONBLOCK: a FIFO named *.AppImage must not hang the open.
+        fd = os.open(app_path, os.O_RDONLY | os.O_NONBLOCK)
+    except OSError as e:
+        print("cannot open %s: %s" % (app_path, e.strerror), file=sys.stderr)
+        return 1
+    try:
+        st = os.fstat(fd)
+        if not stat.S_ISREG(st.st_mode):
+            raise NoIcon("not a regular file")
+        base = squashfs_offset(fd, st.st_size)
+        seen = set()
+        for name in candidates(fd, base):
+            if name in seen:
+                continue
+            seen.add(name)
+            data = read_icon(fd, base, name)
+            ext = image_ext(data) if data else None
+            if ext:
+                print(store(cache_dir, stem, ext, data))
+                return 0
+        raise NoIcon("no icon in image")
+    except NoIcon:
+        return 2
+    except (OSError, RuntimeError) as e:
+        print("icon extraction failed for %s: %s" % (app_path, e), file=sys.stderr)
+        return 1
+    finally:
+        os.close(fd)
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
