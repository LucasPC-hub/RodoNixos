diff -r a/Persona5CalendarWidget.qml b/Persona5CalendarWidget.qml
--- a/Persona5CalendarWidget.qml	2026-10-15 01:41:02.861994027 -0300
+++ b/Persona5CalendarWidget.qml	2026-10-15 01:41:02.874838247 -0300
@@ -224,11 +224,13 @@
                 if (root.clickAction === "refresh") {
                     if (WeatherService) WeatherService.forceRefresh();
                     if (typeof ToastService !== "undefined" && ToastService) {
-                        ToastService.showInfo(I18n.trFor("persona5Calendar", "Weather refreshed"));
+                        ToastService.showInfo(I18n.tr("Weather refreshed"));
                     }
                 } else if (root.clickAction === "dateInfo") {
                     const dateStr = root.now ? root.now.toLocaleDateString(Qt.locale(), Locale.LongFormat) : "";
-                    const tempStr = (WeatherService && WeatherService.currentTempText) ? WeatherService.currentTempText(false) : "";
+                    // DMS 1.4.6 WeatherService has no currentTempText(); inline of master's currentTempText(false).
+                    const tempUnit = SettingsData.useFahrenheit ? "°F" : "°C";
+                    const tempStr = WeatherService ? ((WeatherService.weather.available ? (SettingsData.useFahrenheit ? WeatherService.weather.tempF : WeatherService.weather.temp) : "--") + tempUnit) : "";
                     if (typeof ToastService !== "undefined" && ToastService) {
                         ToastService.showInfo(dateStr + (tempStr ? " • " + tempStr : ""));
                     }
